{
  "name": "xiaohongshu-cover-simulator",
  "version": "0.8.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "npm run seed && next dev --hostname 127.0.0.1",
    "build": "npm run seed && next build",
    "start": "npm run seed && next start --hostname 127.0.0.1",
    "seed": "node scripts/seed-reference-covers.mjs",
    "test": "node --import tsx --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:integration": "node tests/http-regression.mjs",
    "launch": "node scripts/launch.mjs",
    "release:bundle": "node scripts/release-bundle.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "next": "^15.5.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.4",
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
