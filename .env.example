# Copy this file to .env.local and add the API key for the model you want to use.
# Local Ollama is the default and does not need an API key. Only loopback URLs are accepted.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Add your Zhipu API key to enable the GLM models in the model selector.
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-5.3-flash
ZHIPU_GLM_46V_MODEL=glm-4.6v
